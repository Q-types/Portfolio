{
  "version": "ship_synthetic_v1",
  "target": "oil_pressure",
  "feature_sets": ["raw", "physics_motivated"],
  "ridge_alpha": 0.001,
  "residual_quantile": 0.95,
  "z_limit": 3.0,
  "iqr_multiplier": 1.5,
  "percentile_limits": [0.025, 0.975],
  "ocsvm": {"kernel": "rbf", "gamma": 0.2, "nu": 0.05, "tol": 0.001, "max_iter": 10000, "cache_size": 32},
  "isolation_forest": {"n_estimators": 64, "max_samples": 64, "contamination": 0.05, "max_features": 1.0, "random_state": 41, "n_jobs": 1},
  "random_forest": {"n_estimators": 48, "max_depth": 5, "min_samples_leaf": 3, "max_features": 1.0, "random_state": 41, "n_jobs": 1},
  "sensitivity": {"nu": 0.1, "contamination": 0.1},
  "scenarios": {"control": {}, "oil_pressure_shift": {"oil_pressure": 1.5}, "coolant_temp_shift": {"coolant_temp": 12.0}, "rpm_shift": {"engine_rpm": 200.0}}
}
